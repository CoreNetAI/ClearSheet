{
  // Cloudflare Workers deployment config (used by @opennextjs/cloudflare).
  // Local development uses `next dev`; this file only matters for cf:build/deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearsheet",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Set runtime secrets with `wrangler secret put <NAME>` (see INTEGRATIONS.md),
  // or add non-secret vars under a "vars" block here.
}
