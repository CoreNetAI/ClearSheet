# ============================================================================
# ClearSheet environment configuration
# Copy this file to .env.local and fill in values. See Appendix D of the spec.
# Anything left blank simply disables the corresponding optional feature.
# NEVER commit .env.local. Only NEXT_PUBLIC_* values are exposed to the browser.
# ============================================================================

# --- Core: Supabase (ALWAYS required) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, NEVER public

# Postgres connection string (used by the seed script and the backup workflow).
# Supabase -> Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL="postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres"

# --- Core: token encryption (ALWAYS required) -------------------------------
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="generate-a-32-byte-base64-key"

# --- Core: Cloudflare R2 file storage (ALWAYS required) ---------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_UPLOADS_BUCKET="clearsheet-uploads"
R2_BACKUPS_BUCKET="clearsheet-backups"
# Optional: explicit S3 endpoint. Defaults to https://<account_id>.r2.cloudflarestorage.com
# R2_ENDPOINT=""

# --- Core: app + firm identity (ALWAYS required) ----------------------------
APP_BASE_URL="http://localhost:3000"
DEFAULT_TIMEZONE="America/New_York"
FIRM_NAME="Your Firm LLC"
FIRM_ADDRESS="123 Main St, Suite 100, City, ST 00000"
FIRM_EMAIL="billing@yourfirm.com"
# Optional logo shown on invoice PDFs (public https URL to a PNG/JPG)
FIRM_LOGO_URL=""

# Shared secret protecting the scheduled reminder endpoint (/api/cron/reminders).
# The reminders.yml GitHub Action sends it as a Bearer token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="generate-a-random-token"

# --- SSO / OAuth (required only for Google / Microsoft sign-in) -------------
# These are configured in the Supabase dashboard (Auth -> Providers), NOT here.
# Listed for documentation; redirect URI is {APP_BASE_URL}/auth/callback.
# Google:    client id + secret  (Supabase dashboard)
# Microsoft: client id + secret + tenant  (Supabase dashboard)

# --- Email (optional: invoice emailing) -------------------------------------
# Leave RESEND_API_KEY blank to disable the "email invoice" feature.
RESEND_API_KEY=""
FROM_EMAIL="invoices@yourfirm.com"

# --- Payments (optional: online card payment via Stripe) --------------------
# Leave STRIPE_SECRET_KEY blank to disable payment links/checkout.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Accounting (optional: QuickBooks Online sync) --------------------------
# Leave QBO_CLIENT_ID blank to disable the QuickBooks connection.
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:3000/api/integrations/quickbooks/callback"
QBO_ENVIRONMENT="sandbox"   # sandbox | production
